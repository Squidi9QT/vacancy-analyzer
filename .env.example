# Скопируй в .env и поправь под себя: cp .env.example .env
# Строка подключения к PostgreSQL (docker-compose поднимает такую же)
DATABASE_URL=postgresql://analyst:analyst@localhost:5432/vacancies
# База для тестов: её очищают перед каждым тестом, не указывай рабочую!
TEST_DATABASE_URL=postgresql://analyst:analyst@localhost:5432/vacancies_test

# Источник данных: fixtures (по умолчанию, работает без сети) или api
DATA_SOURCE=fixtures
# Дата «сегодня» для режима фикстур — чтобы результаты были воспроизводимы
FIXTURE_NOW=2026-10-30

# Для режима api: hh.ru требует User-Agent с контактом
HH_USER_AGENT=VacancyAnalyzer/0.1 (your-email@example.com)
# Токен приложения hh.ru (анонимные запросы сейчас получают 403)
HH_ACCESS_TOKEN=
# Пауза между запросами, секунды (уважаем лимиты API)
HH_REQUEST_DELAY=0.5

LOG_LEVEL=INFO
